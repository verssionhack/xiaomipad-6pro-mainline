# Standard GNOME desktop compatibility that is independent of liuqin's
# board bring-up.  Values follow the distribution's arm64 generic config
# where practical; modules must match the installed kernel.

# HID accessories and storage commonly attached through the tablet USB port.
CONFIG_HIDRAW=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_USB_UAS=m
CONFIG_EXFAT_FS=m
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_NTFS3_FS=m
CONFIG_NLS_UTF8=m

# USB audio and MIDI.
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_SEQUENCER=m

# nftables is already the installed ufw/iptables backend in the Kali root.
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_COMPAT=m
CONFIG_NF_REJECT_IPV4=m
CONFIG_NF_REJECT_IPV6=m

# NetworkManager VPN/tethering paths shipped by the Kali root.
CONFIG_PPP=y
CONFIG_PPP_ASYNC=m
CONFIG_PPP_DEFLATE=m
CONFIG_PPP_BSDCOMP=m
CONFIG_PPP_MPPE=m
CONFIG_PPPOE=m
CONFIG_NET_IPGRE_DEMUX=m
CONFIG_NET_IPGRE=m
CONFIG_PPTP=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_WIREGUARD=m

# Common USB serial adapters.
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m

# GNOME Files / mount helpers and encrypted or verified volumes.
CONFIG_CIFS=m
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
CONFIG_CIFS_UPCALL=y
CONFIG_DM_CRYPT=m
CONFIG_DM_VERITY=m
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_CRYPTO_USER_API_AEAD=m
