#!/usr/local/bin/busybox sh
# SPDX-License-Identifier: MIT
set -u
BB=/usr/local/bin/busybox
marker=/etc/liuqin-gnome-root
marker_sha=bd86a359f5b6bf05f09abf544967489e924c251ab7c07684df62b0dbda4c3fca

fail() {
	echo "liuqin-gnome-guard: critical: $*" >/dev/kmsg 2>/dev/null || :
	$BB mount -o remount,ro / 2>/dev/null || :
	exit 1
}

[ -f "$marker" ] && [ ! -L "$marker" ] || fail 'root marker missing'
[ "$($BB stat -c '%a %u %g' "$marker" 2>/dev/null)" = '644 0 0' ] || fail 'root marker metadata invalid'
[ "$($BB sha256sum "$marker" | $BB cut -d' ' -f1)" = "$marker_sha" ] || fail 'root marker content invalid'

root_source=
roots=0
while IFS=' ' read -r source target fstype options _; do
	[ "$target" = / ] || continue
	roots=$((roots + 1))
	# The initramfs already proved PARTNAME=userdata before switch_root; the
	# exact partition number varies with the capacity variant, so here the rw
	# pair is derived from the actual root mount on the first UFS LUN.
	case $source in /dev/sda[0-9]*) ;; *) fail 'unexpected root source' ;; esac
	[ "$fstype" = ext4 ] || fail 'unexpected root filesystem'
	case ,$options, in *,rw,*) ;; *) fail 'root is not read-write' ;; esac
	root_source=$source
done </proc/mounts
[ "$roots" = 1 ] || fail 'root mount is missing or duplicated'

# Build a set of partition numbers to skip: /dev/sda (UFS device), root, and
# myswap swap partition (same LUN, different partition).  Skip-set entries are
# "sdaN" strings so the block iteration below can do a straight string match.
skip_sda=
skip_root=$(echo "$root_source" | sed 's|/dev/||')
skip_myswap=
if [ -r /tmp/liuqin-myswap-dev ]; then
	skip_myswap=$(cat /tmp/liuqin-myswap-dev)
elif [ -e /dev/disk/by-partlabel/myswap ]; then
	mswap_dev=$(readlink -f /dev/disk/by-partlabel/myswap 2>/dev/null || true)
	if [ -n "$mswap_dev" ] && echo "$mswap_dev" | grep -q '^/dev/sda[0-9]'; then
		skip_myswap=$(echo "$mswap_dev" | sed 's|/dev/||')
	fi
fi >&2

total=0
for node in /dev/sd*; do
	[ -b "$node" ] || continue
	total=$((total + 1))
	ndev=$(echo "$node" | sed 's|/dev/||')
	case "$ndev" in
		sda)
			# UFS device itself must not be read-only
			[ "$($BB blockdev --getro "$node" 2>/dev/null)" = 0 ] || fail "$node is unexpectedly read-only"
			;;
		"$skip_root"|"$skip_myswap")
			# Root and myswap: must stay read-write
			[ "$($BB blockdev --getro "$node" 2>/dev/null)" = 0 ] || fail "$node is unexpectedly read-only"
			;;
		*)
			$BB blockdev --setro "$node" 2>/dev/null || fail "cannot lock $node"
			[ "$($BB blockdev --getro "$node" 2>/dev/null)" = 1 ] || fail "$node did not stay read-only"
			;;
	esac
done
[ "$total" -ge 2 ] || fail 'no UFS namespace'
echo "liuqin-gnome-guard: PASS ($total nodes; root pair rw, all siblings ro)" >/dev/kmsg 2>/dev/null || :
