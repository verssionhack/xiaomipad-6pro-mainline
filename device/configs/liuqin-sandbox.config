# Sandbox confinement and desktop portal support.
# Build FUSE in so portals and sandboxed app files do not depend on module
# loading during startup.
CONFIG_FUSE_FS=y

# Capability-backed confinement reads a file's security.capability xattr from
# the filesystem it is exec'd from.  Without squashfs xattr support that xattr
# is invisible on a mounted squashfs image even though getcap looks right, so
# keep xattr on the read-only image format the base image and any squashfs
# payload use.
CONFIG_SQUASHFS_XATTR=y

# AppArmor is the distribution's default confinement LSM.  Selecting AppArmor
# alone is insufficient when an explicit CONFIG_LSM string omits it; make it
# the default major LSM and keep it in the ordered stack.
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,apparmor,ipe,bpf"
